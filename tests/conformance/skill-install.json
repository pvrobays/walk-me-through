{
  "skillDirectory": ".agents/skills/walk-me-through",
  "files": [
    "SKILL.md",
    "manifest.json",
    "references/walkthrough-format.md",
    "scripts/publish-walkthrough.mjs"
  ],
  "cases": [
    {
      "name": "fresh",
      "description": "Repository without the skill: all four files are created.",
      "setup": [
        {
          "path": "repo/.git",
          "type": "directory"
        }
      ],
      "folders": [
        "repo"
      ],
      "expected": {
        "targets": [
          {
            "root": "repo",
            "inGit": true
          }
        ],
        "outcome": "installed",
        "created": [
          "SKILL.md",
          "manifest.json",
          "references/walkthrough-format.md",
          "scripts/publish-walkthrough.mjs"
        ],
        "differing": [],
        "message": "Installed the Walk Me Through skill in {skillDir}. Commit .agents/skills/walk-me-through/ and restart your agent so it discovers the skill.",
        "after": {
          "SKILL.md": "bundle",
          "manifest.json": "bundle",
          "references/walkthrough-format.md": "bundle",
          "scripts/publish-walkthrough.mjs": "bundle"
        }
      }
    },
    {
      "name": "crlf-identical",
      "description": "All four files present with a BOM and CRLF line endings: identical after normalization.",
      "setup": [
        {
          "path": "repo/.git",
          "type": "directory"
        },
        {
          "path": "repo/.agents/skills/walk-me-through/SKILL.md",
          "type": "bundle",
          "file": "SKILL.md",
          "variant": "bom-crlf"
        },
        {
          "path": "repo/.agents/skills/walk-me-through/manifest.json",
          "type": "bundle",
          "file": "manifest.json",
          "variant": "bom-crlf"
        },
        {
          "path": "repo/.agents/skills/walk-me-through/references/walkthrough-format.md",
          "type": "bundle",
          "file": "references/walkthrough-format.md",
          "variant": "bom-crlf"
        },
        {
          "path": "repo/.agents/skills/walk-me-through/scripts/publish-walkthrough.mjs",
          "type": "bundle",
          "file": "scripts/publish-walkthrough.mjs",
          "variant": "bom-crlf"
        }
      ],
      "folders": [
        "repo"
      ],
      "expected": {
        "targets": [
          {
            "root": "repo",
            "inGit": true
          }
        ],
        "outcome": "already-installed",
        "created": [],
        "differing": [],
        "message": "The Walk Me Through skill is already installed in {skillDir}. Nothing was changed.",
        "after": {
          "SKILL.md": "setup",
          "manifest.json": "setup",
          "references/walkthrough-format.md": "setup",
          "scripts/publish-walkthrough.mjs": "setup"
        }
      }
    },
    {
      "name": "customized-skill",
      "description": "A customized SKILL.md: nothing is written, including the missing files.",
      "setup": [
        {
          "path": "repo/.git",
          "type": "directory"
        },
        {
          "path": "repo/.agents/skills/walk-me-through/SKILL.md",
          "type": "file",
          "text": "# My customized skill\n"
        }
      ],
      "folders": [
        "repo"
      ],
      "expected": {
        "targets": [
          {
            "root": "repo",
            "inGit": true
          }
        ],
        "outcome": "refused",
        "created": [],
        "differing": [
          "SKILL.md"
        ],
        "message": "The Walk Me Through skill in {skillDir} was left unchanged because these files differ from the bundled version: SKILL.md. Review or remove them, then run Install Skill into Project again.",
        "after": {
          "SKILL.md": "setup",
          "manifest.json": "missing",
          "references/walkthrough-format.md": "missing",
          "scripts/publish-walkthrough.mjs": "missing"
        }
      }
    },
